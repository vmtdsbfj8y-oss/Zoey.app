# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# ...and the same name as a symlink. The trailing slash above only matches a directory, so a
# `node_modules` SYMLINK -- which is how a git worktree is usually pointed at a shared install --
# sails past it and gets staged by `git add -A`. That committed an absolute path into the tree,
# which would break every clone, CI run and EAS build that touched it.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
.vercel
.env*

# local scratch / not part of the app
Screenshot*.png
zoey-chat-update/

# Simulator captures from verification runs. Evidence for a review, never part of the app --
# and they are photographs of a signed-in session, so they must not become committable by
# accident by anyone reaching for `git add -A`.
docs/interview-verification/
